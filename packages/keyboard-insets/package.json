{
	"name": "@ftsukic/keyboard-insets",
	"description": "A Keyboard Avoiding View for React Native.",
	"version": "1.0.6",
	"main": "./dist/index",
	"module": "./dist/index",
	"types": "./dist/index.d.ts",
	"react-native": "src/index",
	"source": "src/index",
	"nativePackage": true,
	"files": [
		"src",
		"dist",
		"android",
		"ios",
		"common",
		"harmony",
		"react-native.config.js",
		"RNKeyboardInsets.podspec",
		"!android/build",
		"!ios/build",
		"!**/__tests__"
	],
	"repository": "https://github.com/ftsukic/react-native-troika",
	"homepage": "https://github.com/ftsukic/react-native-troika/tree/develop/packages/keyboard-insets#readme",
	"publishConfig": {
		"access": "public"
	},
	"author": "sdcx",
	"license": "MIT",
	"keywords": [
		"react-native",
		"keyboard-aware",
		"keyboard-avoiding",
		"keyboard-tool",
		"keyboard-insets"
	],
	"scripts": {
		"build": "rm -rf ./dist && tsc -p tsconfig.json",
		"prepare": "npm run build",
		"tsc": "tsc",
		"test": "jest",
		"lint": "eslint . --fix --ext .js,.jsx,.ts,.tsx"
	},
	"peerDependencies": {
		"react": ">=16.8",
		"react-native": ">=0.60"
	},
	"devDependencies": {},
	"codegenConfig": {
		"name": "keyboardinsets",
		"type": "components",
		"jsSrcsDir": "src",
		"android": {
			"javaPackageName": "com.reactnative.keyboardinsets"
		},
		"ios": {
			"componentProvider": {
				"KeyboardInsetsView": "RNKeyboardInsetsView"
			}
		}
	},
	"harmony": {
		"codegenConfig": {
			"specPaths": ["src/KeyboardInsetsViewHarmonyNativeComponent.ts"],
			"version": 2
		},
		"autolinking": {
			"ohPackageName": "@rnoh/react-native-keyboard-insets",
			"etsPackageClassName": "KeyboardInsetsPackage",
			"cppPackageClassName": "ReactNativeKeyboardInsetsPackage",
			"cmakeLibraryTargetName": "rnoh__keyboard_insets"
		}
	}
}
